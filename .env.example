OLLAMA_BASE_URL=http://127.0.0.1:11434
PRIMARY_LLM_MODEL=ministral-3:3b-cloud
FALLBACK_LLM_MODEL=ministral-3:8b-cloud
CORS_ORIGINS=http://localhost:3000
# Public base URL for the Lance backend (ngrok URL in dev, static IP in prod)
LANCE_BASE_URL=http://localhost:8000
MAX_CONCURRENT_LLM_REQUESTS=2
RAG_TEMPERATURE=0.1
RAG_NUM_PREDICT=1024
FAQ_DIR=data/faqs
INSTRUCTIONS_DIR=data/instructions
PLATFORMS_CONFIG=app/rag/platforms.yaml
MAX_CHUNK_TOKENS=400
RETRIEVAL_TOP_K=1
GROUNDING_TOP_K=3
MAX_PARENT_SOURCES=3
MAX_EXPANDED_CONTEXT_CHARS=12000
EMBEDDING_MODEL=all-MiniLM-L6-v2
FAQ_DIRECT_MIN_CONFIDENCE=0.2
ENABLE_SAFETY_FILTER=true
ENABLE_SAFETY_CLASSIFIER=true
ENABLE_GROUNDING_VERIFIER=true
ENABLE_INTAKE_LLM_PLANNER=true
INTAKE_PLANNER_MODEL=ministral-3:3b-cloud
INTAKE_PLANNER_FALLBACK_MODEL=ministral-3:8b-cloud
INTAKE_PLANNER_TIMEOUT=20
INTAKE_PLANNER_MAX_TOKENS=160
CONTENT_ARCHIVE_DIR=data/_archive
FEEDBACK_DIR=data/feedback
FIREBASE_SERVICE_ACCOUNT_PATH=app/firebase-service-account.json
FIREBASE_STORAGE_BUCKET=lance-cbu.firebasestorage.app
LANCE_ADMIN_USER=admin
LANCE_ADMIN_PASSWORD=change-me
ENABLE_DEBUG_ROUTES=false
ENABLE_DEBUG_MODE=false
